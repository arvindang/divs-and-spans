{
  "name": "divs-and-spans",
  "version": "1.0.0",
  "description": "Divs & Spans — a visual-markdown design canvas that LLMs draw on over MCP",
  "scripts": {
    "build:web": "esbuild web/canvas.ts web/home.ts --bundle --format=esm --target=es2022 --outdir=public/js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p . && tsc -p web",
    "smoke": "node scripts/smoke.mjs",
    "weekly": "node scripts/weekly.mjs"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fflate": "^0.8.3",
    "node-html-parser": "^9.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.2"
  },
  "private": true,
  "type": "module"
}
